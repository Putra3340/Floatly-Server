<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Floatly — Floating Media Player for Seamless Workflows</title>
    <!-- Replaced Tailwind with Bootstrap 5.3 -->
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        :root {
            --primary-color: #a855f7;
            --accent-color: #303099;
            --bg-dark: #0a0a0a;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: #ffffff;
            overflow-x: hidden;
        }

        .gradient-text {
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-gradient {
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            border: none;
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 50rem;
            font-weight: 600;
            transition: transform 0.2s, opacity 0.2s;
        }

            .btn-gradient:hover {
                color: white;
                opacity: 0.9;
                transform: scale(1.05);
            }

        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1.5rem;
        }

        .nav-custom {
            transition: all 0.3s ease;
            padding: 1rem 0;
        }

        .nav-scrolled {
            background: rgba(10, 10, 10, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.5rem 0;
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        canvas#particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.4;
        }

        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            padding-top: 80px;
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <canvas id="particles"></canvas>

    <!-- Navigation -->
    <nav id="navbar" class="navbar navbar-expand-md navbar-dark fixed-top nav-custom">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <div class="rounded-3 bg-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: linear-gradient(to tr, var(--primary-color), var(--accent-color));">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                </div>
                <span class="fw-bold">Floatly</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-md-4">
                    <li class="nav-item"><a class="nav-link text-white-50" href="#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link text-white-50" href="#showcase">Showcase</a></li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 d-flex align-items-center gap-2" href="#">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
                            GitHub
                        </a>
                    </li>
                    <li class="nav-item ms-md-2">
                        <button class="btn btn-gradient">Get Started</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); font-size: 0.8rem; color: var(--primary-color);">
                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                        <span>The Ultimate Floating Media Player</span>
                    </div>
                    <h1 class="display-3 fw-bold mb-4">
                        Watch Without <br>
                        <span class="gradient-text">Interrupting</span> Your <br>
                        Workflow
                    </h1>
                    <p class="lead text-white-50 mb-5" style="max-width: 550px;">
                        Floatly is a lightweight floating media player that lets you watch videos or listen to music while you work,
                        without blocking your clicks or annoying your screen.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <button class="btn btn-gradient btn-lg d-flex align-items-center gap-2">
                            Download Player <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                        </button>
                        <button class="btn btn-outline-light btn-lg rounded-pill px-4 glass text-white fw-bold">
                            View on GitHub
                        </button>
                    </div>
                </div>
                <div class="col-lg-5 text-center">
                    <div class="animate-float position-relative">
                        <div class="glass mx-auto overflow-hidden shadow-lg" style="max-width: 450px; aspect-ratio: 1; border-radius: 2rem;">
                            <!-- Header Bar -->
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 bg-white-10" style="background: rgba(255,255,255,0.05);">
                                <div class="d-flex gap-1">
                                    <div class="rounded-circle bg-danger" style="width: 10px; height: 10px; opacity: 0.5;"></div>
                                    <div class="rounded-circle bg-warning" style="width: 10px; height: 10px; opacity: 0.5;"></div>
                                    <div class="rounded-circle bg-success" style="width: 10px; height: 10px; opacity: 0.5;"></div>
                                </div>
                                <div style="font-size: 10px; opacity: 0.3; font-weight: 600;">FLOATLY PLAYER</div>
                            </div>
                            <!-- Video Area -->
                            <div class="d-flex align-items-center justify-content-center h-100 position-relative" style="background: rgba(0,0,0,0.3);">
                                <div class="rounded-circle glass d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                    <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24" class="ms-1 text-white"><path d="M8 5v14l11-7z" /></svg>
                                </div>
                                <!-- Controls Overlay -->
                                <div class="position-absolute bottom-0 start-0 end-0 p-4" style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                                    <div class="progress mb-2" style="height: 4px; background: rgba(255,255,255,0.1);">
                                        <div class="progress-bar" style="width: 35%; background: var(--primary-color);"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="rounded-pill bg-white-50" style="width: 80px; height: 8px; opacity: 0.4;"></div>
                                        <div class="rounded-pill bg-white-50" style="width: 30px; height: 8px; opacity: 0.2;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-5">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Focus on <span class="gradient-text">What Matters</span></h2>
                <p class="text-white-50 mx-auto" style="max-width: 600px;">
                    Designed to be invisible when you don't need it, and powerful when you do.
                </p>
            </div>

            <div class="row g-5 align-items-center py-5">
                <div class="col-lg-6">
                    <div class="glass feature-icon text-warning">
                        <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    </div>
                    <h3 class="h2 fw-bold mb-3">Click-Through Transparency</h3>
                    <p class="text-white-50 fs-5 mb-0">Enable ghost mode to make the player completely non-interactive. Click right through the video to control the apps underneath without interruption.</p>
                </div>
                <div class="col-lg-6">
                    <div class="glass p-5 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                        <svg width="100" height="100" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.1; color: var(--accent-color);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    </div>
                </div>
            </div>

            <div class="row g-5 align-items-center py-5 flex-lg-row-reverse">
                <div class="col-lg-6">
                    <div class="glass feature-icon text-primary">
                        <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" /></svg>
                    </div>
                    <h3 class="h2 fw-bold mb-3">Always on Top, Never in the Way</h3>
                    <p class="text-white-50 fs-5 mb-0">Smart pinning ensures your media stays visible, while intelligent edge-snapping and opacity controls keep your screen clean and organized.</p>
                </div>
                <div class="col-lg-6">
                    <div class="glass p-5 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                        <svg width="100" height="100" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.1; color: var(--primary-color);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" /></svg>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Showcase -->
    <section id="showcase" class="py-5">
        <div class="container py-5">
            <div class="glass p-5 p-md-5 text-center position-relative overflow-hidden" style="border-radius: 3rem;">
                <h2 class="display-4 fw-bold mb-4 mt-5">Experience <span class="gradient-text">Seamless</span> Overlays</h2>
                <p class="text-white-50 fs-5 mx-auto mb-5" style="max-width: 700px;">
                    Stop switching windows. Start floating. Floatly provides a persistent workspace that stays exactly where you need it.
                </p>
                <div class="glass bg-white-5 border-white-5 d-flex flex-column align-items-center justify-content-center mx-auto mb-5" style="max-width: 800px; height: 350px;">
                    <div class="d-flex gap-3">
                        <div class="rounded-circle glass animate-float" style="width: 60px; height: 60px;"></div>
                        <div class="rounded-circle glass animate-float" style="width: 60px; height: 60px; animation-delay: 0.3s;"></div>
                        <div class="rounded-circle glass animate-float" style="width: 60px; height: 60px; animation-delay: 0.6s;"></div>
                    </div>
                    <div class="mt-4 text-white-50 fw-bold letter-spacing-widest" style="font-size: 0.7rem; letter-spacing: 0.3em; opacity: 0.3;">FLOATLY CORE ENGINE</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-5 border-top border-white-10" style="border-color: rgba(255,255,255,0.05) !important;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2">
                        <div class="rounded-2 bg-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: linear-gradient(to tr, var(--primary-color), var(--accent-color));">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                        </div>
                        <span class="fw-bold">Floatly</span>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="small text-white-50 mb-0">© 2025 Floatly Open Source. MIT Licensed.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle with Popper -->
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>

    <script>
        // Particles Background
        const canvas = document.getElementById('particles');
        const ctx = canvas.getContext('2d');
        let particles = [];

        class Particle {
            constructor() {
                this.init();
            }
            init() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 1;
                this.speedX = Math.random() * 0.5 - 0.25;
                this.speedY = Math.random() * 0.5 - 0.25;
                this.opacity = Math.random() * 0.3 + 0.1;
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width) this.x = 0;
                else if (this.x < 0) this.x = canvas.width;
                if (this.y > canvas.height) this.y = 0;
                else if (this.y < 0) this.y = canvas.height;
            }
            draw() {
                ctx.fillStyle = `rgba(168, 85, 247, ${this.opacity})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function initParticles() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            particles = [];
            for (let i = 0; i < 40; i++) {
                particles.push(new Particle());
            }
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', initParticles);
        initParticles();
        animate();

        // Navbar Scroll Effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 20) {
                nav.classList.add('nav-scrolled');
            } else {
                nav.classList.remove('nav-scrolled');
            }
        });
    </script>
</body>
</html>
