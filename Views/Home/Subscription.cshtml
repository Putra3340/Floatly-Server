<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Membership - Subscription Plans</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 100%);
            color: #e4e6eb;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            background: rgba(15, 15, 30, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(99, 102, 241, 0.2);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        nav a {
            color: #a0aec0;
            text-decoration: none;
            margin-left: 2.5rem;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }

            nav a:hover {
                color: #6366f1;
            }

        /* Hero Section */
        .hero {
            margin-top: 6rem;
            padding: 4rem 5%;
            text-align: center;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: #a78bfa;
            padding: 0.5rem 1.2rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            margin-bottom: 1.2rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .hero p {
            font-size: 1.15rem;
            color: #cbd5e1;
            max-width: 600px;
            margin: 0 auto 3rem;
            line-height: 1.6;
        }

        /* Pricing Container */
        .pricing-container {
            display: flex;
            justify-content: center;
            padding: 3rem 5%;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .pricing-card {
            background: rgba(30, 30, 50, 0.8);
            border: 2px solid rgba(99, 102, 241, 0.2);
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
            position: relative;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            backdrop-filter: blur(10px);
        }

            .pricing-card:hover {
                border-color: #6366f1;
                box-shadow: 0 0 30px rgba(99, 102, 241, 0.3);
                transform: translateY(-8px);
            }

        .pricing-header {
            margin-bottom: 2rem;
        }

        .plan-name {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .price {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: inline;
        }

        .currency {
            font-size: 1.5rem;
            margin-right: 0.3rem;
        }

        .billing-period {
            color: #a0aec0;
            font-size: 0.95rem;
            margin-left: 0.5rem;
        }

        .plan-description {
            color: #cbd5e1;
            font-size: 0.95rem;
            margin: 1rem 0 2rem;
            line-height: 1.5;
        }

        /* Features List */
        .features-list {
            list-style: none;
            margin-bottom: 2.5rem;
            border-top: 1px solid rgba(99, 102, 241, 0.2);
            border-bottom: 1px solid rgba(99, 102, 241, 0.2);
            padding: 2rem 0;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1.2rem;
            font-size: 0.95rem;
        }

            .feature-item:last-child {
                margin-bottom: 0;
            }

        .feature-icon {
            width: 24px;
            height: 24px;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            flex-shrink: 0;
            font-size: 0.8rem;
        }

        .feature-text {
            color: #cbd5e1;
            line-height: 1.4;
        }

        /* CTA Button */
        .cta-button {
            width: 100%;
            padding: 1.1rem 2rem;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
            position: relative;
            overflow: hidden;
        }

            .cta-button::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .cta-button:hover::before {
                width: 300px;
                height: 300px;
            }

            .cta-button:hover {
                box-shadow: 0 12px 30px rgba(99, 102, 241, 0.5);
                transform: translateY(-2px);
            }

            .cta-button:active {
                transform: translateY(0);
            }

        /* FAQ Section */
        .faq-section {
            padding: 4rem 5%;
            max-width: 700px;
            margin: 2rem auto;
        }

            .faq-section h2 {
                text-align: center;
                font-size: 2.2rem;
                margin-bottom: 3rem;
                font-weight: 700;
            }

        .faq-item {
            background: rgba(30, 30, 50, 0.6);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 10px;
            margin-bottom: 1.2rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .faq-item:hover {
                border-color: rgba(99, 102, 241, 0.4);
            }

        .faq-question {
            padding: 1.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 1rem;
            user-select: none;
            transition: all 0.3s ease;
        }

            .faq-question:hover {
                color: #6366f1;
            }

        .faq-toggle {
            font-size: 1.5rem;
            transition: transform 0.3s ease;
            color: #6366f1;
        }

        .faq-item.active .faq-toggle {
            transform: rotate(180deg);
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(99, 102, 241, 0.05);
        }

        .faq-item.active .faq-answer {
            max-height: 200px;
        }

        .faq-answer p {
            padding: 1.5rem;
            color: #cbd5e1;
            line-height: 1.6;
        }

        /* Footer */
        footer {
            padding: 2rem 5%;
            text-align: center;
            color: #a0aec0;
            border-top: 1px solid rgba(99, 102, 241, 0.2);
            margin-top: 4rem;
        }

            footer p {
                margin-bottom: 0.5rem;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            nav {
                padding: 1rem 4%;
                flex-wrap: wrap;
                gap: 1rem;
            }

                nav a {
                    margin-left: 1.5rem;
                    font-size: 0.85rem;
                }

            .hero {
                margin-top: 5rem;
                padding: 2rem 4%;
            }

                .hero h1 {
                    margin-bottom: 1rem;
                }

            .pricing-card {
                padding: 2rem;
                max-width: 100%;
            }

            .price {
                font-size: 2.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav>
        <div class="logo">Premium+</div>
        <div>
            <a href="#pricing">Pricing</a>
            <a href="#faq">FAQ</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-badge">✨ New Features Available</div>
        <h1>Unlock Premium Features</h1>
        <p>Get unlimited access to all features, priority support, and exclusive content. Join thousands of satisfied members today.</p>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="pricing-container">
        <div class="pricing-card">
            <div class="pricing-header">
                <h3 class="plan-name">Premium Plan</h3>
                <div>
                    <span class="price"><span class="currency">$</span>29</span>
                    <span class="billing-period">/month</span>
                </div>
                <p class="plan-description">Everything you need to grow and succeed</p>
            </div>

            <ul class="features-list">
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Unlimited projects and collaborators</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Advanced analytics and reporting</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Priority 24/7 customer support</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Custom integrations and API access</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Advanced security and compliance</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Monthly feature updates</span>
                </li>
            </ul>

            <button class="cta-button" onclick="handleSubscribe()">Start Your Free Trial</button>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="faq-section">
        <h2>Frequently Asked Questions</h2>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>What payment methods do you accept?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>We accept all major credit cards (Visa, Mastercard, American Express), PayPal, and bank transfers for annual subscriptions. All payments are secure and encrypted.</p>
            </div>
        </div>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>Can I cancel anytime?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>Yes! You can cancel your subscription at any time. Your access will continue until the end of your current billing period, and we'll process any refunds according to our policy.</p>
            </div>
        </div>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>Is there a free trial?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>We offer a 14-day free trial with full access to all Premium Plan features. No credit card required to get started.</p>
            </div>
        </div>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>Do you offer team/enterprise plans?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>Yes! For teams and enterprises, we offer custom plans with unlimited users, dedicated support, and advanced security features. Contact our sales team for more information.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contact">
        <p>&copy; 2025 Premium+. All rights reserved.</p>
        <p><a href="#" style="color: #6366f1; text-decoration: none;">Privacy Policy</a> | <a href="#" style="color: #6366f1; text-decoration: none;">Terms of Service</a></p>
    </footer>

    <script>
        function toggleFAQ(element) {
            const faqItem = element.parentElement;
            faqItem.classList.toggle('active');
        }

        function handleSubscribe() {
            const event = new CustomEvent('subscriptionClick', {
                detail: { plan: 'Premium Plan', price: 29 }
            });

            console.log('Subscription initiated for Premium Plan - $29/month');
            alert('Thank you for your interest! Redirecting to payment...');
            // In a real app, redirect to payment processor
        }

        // Smooth scroll for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // Add animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.pricing-card, .faq-item').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    </script>
</body>
</html>