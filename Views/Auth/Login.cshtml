<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Floatly — Login</title>

    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --primary-color: #4f46e5;
            --accent-color: #6366f1;
            --bg-dark: #0a0a0a;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient( circle at top, rgba(99,102,241,0.12), transparent 40% ), var(--bg-dark);
            color: #fff;
            min-height: 100vh;
            overflow: hidden;
        }

        canvas#particles {
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: 0.35;
        }

        .login-card {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 1.75rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        .login-title {
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .gradient-text {
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .form-label {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.6);
            margin-bottom: 6px;
        }

        .form-control {
            background: rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            border-radius: 0.75rem;
            padding: 12px 14px;
        }

            .form-control::placeholder {
                color: rgba(255,255,255,0.35);
            }

            .form-control:focus {
                background: rgba(0,0,0,0.45);
                border-color: var(--accent-color);
                box-shadow: 0 0 0 0.15rem rgba(99,102,241,0.25);
                color: #fff;
            }

        .btn-gradient {
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            border: none;
            border-radius: 50rem;
            padding: 12px;
            font-weight: 600;
            color: #fff;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

            .btn-gradient:hover {
                transform: translateY(-2px);
                opacity: 0.95;
            }

        .helper-link {
            color: rgba(255,255,255,0.45);
            font-size: 0.85rem;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .helper-link:hover {
                color: #fff;
            }

        .logo-circle {
            width: 56px;
            height: 56px;
            border-radius: 1rem;
            background: linear-gradient(to tr, var(--primary-color), var(--accent-color));
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

            .logo-circle img {
                width: 34px;
                height: 34px;
            }
    </style>
</head>

<body>
    <canvas id="particles"></canvas>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-6 col-lg-4">
                <div class="login-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="logo-circle">
                            <img src="~/icon-logo.png" alt="Floatly">
                        </div>
                        <h2 class="login-title">
                            Welcome to <span class="gradient-text">Floatly</span>
                        </h2>
                        <p class="text-white-50 small mb-0">
                            Sign in to manage your workspace
                        </p>
                    </div>

                    <form method="post" action="/Auth/Login">
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" name="username" class="form-control" placeholder="Enter your username" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-gradient btn-lg">
                                Login
                            </button>
                        </div>
                    </form>

                    <div class="text-center">
                        <a href="#" class="helper-link"
                           onclick="alert('Check server configuration or documentation.'); return false;">
                            What’s the password?
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        // subtle particle background, same soul as homepage
        const canvas = document.getElementById('particles');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.r = Math.random() * 2 + 0.5;
                this.vx = Math.random() * 0.4 - 0.2;
                this.vy = Math.random() * 0.4 - 0.2;
                this.o = Math.random() * 0.3 + 0.1;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                if (this.x < 0) this.x = canvas.width;
                if (this.x > canvas.width) this.x = 0;
                if (this.y < 0) this.y = canvas.height;
                if (this.y > canvas.height) this.y = 0;
            }
            draw() {
                ctx.fillStyle = `rgba(168,85,247,${this.o})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function init() {
            resize();
            particles = Array.from({ length: 30 }, () => new Particle());
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', init);
        init();
        animate();
    </script>
</body>
</html>
