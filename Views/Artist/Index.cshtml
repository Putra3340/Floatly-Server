@model IEnumerable<Floaty_Music.Models.Artists>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Artists</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <h2>Artists</h2>
        <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#artistModal"
                onclick="openModal()">
            + Add Artist
        </button>

        <table class="table table-bordered">
            <thead>
                <tr><th>Name</th><th>Bio</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var artist in Model)
                {
                    <tr>
                        <td>@artist.Name</td>
                        <td>@artist.Bio</td>
                        <td>
                            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#artistModal"
                                    onclick="openModal(@artist.Id, '@artist.Name', '@artist.Bio')">
                                Edit
                            </button>

                            <form asp-action="Delete" asp-route-id="@artist.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete @artist.Name?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="artistModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="artistForm" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Artist</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Id" id="artistId" />
                        <div class="mb-3">
                            <label for="artistName" class="form-label">Name</label>
                            <input type="text" name="Name" id="artistName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="artistBio" class="form-label">Bio</label>
                            <textarea name="Bio" id="artistBio" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openModal(id = 0, name = '', bio = '') {
            document.getElementById('artistId').value = id;
            document.getElementById('artistName').value = name;
            document.getElementById('artistBio').value = bio;
            document.getElementById('artistForm').action = id == 0 ? '/Artist/Create' : '/Artist/Edit';
        }
    </script>
</body>
</html>
