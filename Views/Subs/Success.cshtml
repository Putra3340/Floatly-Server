@using Floaty_Music
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Payment Successful ✨</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background: #0a0a0a;
            color: #e4e6eb;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .success-card {
            background: rgba(30, 30, 50, 0.85);
            border: 2px solid rgba(99, 102, 241, 0.35);
            border-radius: 18px;
            padding: 3rem;
            max-width: 520px;
            width: 100%;
            text-align: center;
            backdrop-filter: blur(12px);
            box-shadow: 0 0 40px rgba(99, 102, 241, 0.25);
            animation: floatIn 0.8s ease;
        }

        @@keyframes floatIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .success-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, #10b981, #059669);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            color: white;
            box-shadow: 0 0 25px rgba(16, 185, 129, 0.6);
        }

        h1 {
            font-size: 2.4rem;
            margin-bottom: 0.8rem;
            font-weight: 700;
        }

        .subtitle {
            color: #cbd5e1;
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .details {
            background: rgba(99, 102, 241, 0.08);
            border: 1px solid rgba(99, 102, 241, 0.25);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            text-align: left;
            font-size: 0.95rem;
        }

        .details-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.8rem;
        }

            .details-row:last-child {
                margin-bottom: 0;
            }

        .label {
            color: #a0aec0;
        }

        .value {
            color: #e4e6eb;
            font-weight: 600;
        }

        .cta {
            display: inline-block;
            padding: 1rem 2.2rem;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border-radius: 12px;
            color: white;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
        }

            .cta:hover {
                transform: translateY(-2px);
                box-shadow: 0 14px 35px rgba(99, 102, 241, 0.6);
            }

        .note {
            margin-top: 1.5rem;
            font-size: 0.85rem;
            color: #a0aec0;
        }
    </style>
</head>
<body>

    <div class="success-card">
        <div class="success-icon">✓</div>

        <h1>Payment Successful</h1>
        <p class="subtitle">
            Welcome to <strong>Floatly+</strong> ✨
            Your subscription is now active and ready to shine.
        </p>

        <div class="details">
            <div class="details-row">
                <span class="label">Username</span>
                <span class="value">@ViewBag.Trx.User.Username</span>
            </div>
            <div class="details-row">
                <span class="label">Status</span>
                <span class="value">Paid</span>
            </div>
            <div class="details-row">
                <span class="label">Plan</span>
                <span class="value">Floatly+</span>
            </div>
            <div class="details-row">
                <span class="label">Access</span>
                <span class="value">+ 30 Days</span>
            </div>
        </div>

        <a href="/" class="cta">Go to Home</a>

        <div class="note">
            If you have any issues, our support is always here for you 💜
        </div>
    </div>

</body>
</html>
