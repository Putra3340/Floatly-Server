@using Floaty_Music
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Membership - Subscription Plans</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #0a0a0a;
            color: #e4e6eb;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(99, 102, 241, 0.2);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        nav a {
            color: #a0aec0;
            text-decoration: none;
            margin-left: 2.5rem;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }

            nav a:hover {
                color: #6366f1;
            }

        /* Hero Section */
        .hero {
            margin-top: 6rem;
            padding: 4rem 5%;
            text-align: center;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: #a78bfa;
            padding: 0.5rem 1.2rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            margin-bottom: 1.2rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .hero p {
            font-size: 1.15rem;
            color: #cbd5e1;
            max-width: 600px;
            margin: 0 auto 3rem;
            line-height: 1.6;
        }

        /* Pricing Container */
        .pricing-container {
            display: flex;
            justify-content: center;
            padding: 3rem 5%;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .pricing-card {
            background: rgba(30, 30, 50, 0.8);
            border: 2px solid rgba(99, 102, 241, 0.2);
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
            position: relative;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            backdrop-filter: blur(10px);
        }

            .pricing-card:hover {
                border-color: #6366f1;
                box-shadow: 0 0 30px rgba(99, 102, 241, 0.3);
                transform: translateY(-8px);
            }

        .pricing-header {
            margin-bottom: 2rem;
        }

        .plan-name {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .price {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: inline;
        }

        .currency {
            font-size: 1.5rem;
            margin-right: 0.3rem;
        }

        .billing-period {
            color: #a0aec0;
            font-size: 0.95rem;
            margin-left: 0.5rem;
        }

        .plan-description {
            color: #cbd5e1;
            font-size: 0.95rem;
            margin: 1rem 0 2rem;
            line-height: 1.5;
        }

        /* Features List */
        .features-list {
            list-style: none;
            margin-bottom: 2.5rem;
            border-top: 1px solid rgba(99, 102, 241, 0.2);
            border-bottom: 1px solid rgba(99, 102, 241, 0.2);
            padding: 2rem 0;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1.2rem;
            font-size: 0.95rem;
        }

            .feature-item:last-child {
                margin-bottom: 0;
            }

        .feature-icon {
            width: 24px;
            height: 24px;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            flex-shrink: 0;
            font-size: 0.8rem;
        }

        .feature-text {
            color: #cbd5e1;
            line-height: 1.4;
        }

        /* CTA Button */
        .cta-button {
            width: 100%;
            padding: 1.1rem 2rem;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
            position: relative;
            overflow: hidden;
        }

            .cta-button::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .cta-button:hover::before {
                width: 300px;
                height: 300px;
            }

            .cta-button:hover {
                box-shadow: 0 12px 30px rgba(99, 102, 241, 0.5);
                transform: translateY(-2px);
            }

            .cta-button:active {
                transform: translateY(0);
            }

            .cta-button:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        /* Subscription Form */
        .subscription-form {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
            margin-top: 0;
        }

            .subscription-form.active {
                max-height: 800px;
                margin-top: 1.5rem;
            }

        .form-section {
            background: rgba(99, 102, 241, 0.05);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

            .form-section h4 {
                font-size: 1.1rem;
                margin-bottom: 1rem;
                color: #a78bfa;
            }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.5rem;
                font-size: 0.9rem;
                color: #cbd5e1;
            }

        .form-input {
            width: 100%;
            padding: 0.8rem;
            background: rgba(30, 30, 50, 0.6);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 8px;
            color: #e4e6eb;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .form-input:focus {
                outline: none;
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

        .verify-button {
            width: 100%;
            padding: 0.9rem;
            background: linear-gradient(135deg, #10b981, #059669);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 0.5rem;
        }

            .verify-button:hover {
                box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
                transform: translateY(-2px);
            }

            .verify-button:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .verification-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.8rem;
            border-radius: 8px;
            font-size: 0.9rem;
            margin-top: 1rem;
        }

            .verification-status.success {
                background: rgba(16, 185, 129, 0.1);
                border: 1px solid rgba(16, 185, 129, 0.3);
                color: #10b981;
            }

            .verification-status.error {
                background: rgba(239, 68, 68, 0.1);
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #ef4444;
            }

            .verification-status.loading {
                background: rgba(99, 102, 241, 0.1);
                border: 1px solid rgba(99, 102, 241, 0.3);
                color: #6366f1;
            }

        .spinner {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(99, 102, 241, 0.3);
            border-top-color: #6366f1;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .payment-section {
            display: none;
        }

            .payment-section.active {
                display: block;
            }

        .payment-options {
            display: grid;
            gap: 1rem;
            margin-top: 1rem;
        }

        .payment-option {
            background: rgba(30, 30, 50, 0.6);
            border: 2px solid rgba(99, 102, 241, 0.3);
            border-radius: 10px;
            padding: 1.5rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .payment-option:hover {
                border-color: #6366f1;
                background: rgba(99, 102, 241, 0.1);
            }

            .payment-option.selected {
                border-color: #10b981;
                background: rgba(16, 185, 129, 0.1);
            }

            .payment-option h5 {
                font-size: 1.1rem;
                margin-bottom: 0.5rem;
                color: #e4e6eb;
            }

            .payment-option p {
                font-size: 0.85rem;
                color: #a0aec0;
            }

        .payment-details {
            display: none;
            margin-top: 1rem;
            padding: 1.5rem;
            background: rgba(99, 102, 241, 0.05);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 10px;
        }

            .payment-details.active {
                display: block;
            }

        .payment-qr {
            text-align: center;
            padding: 1rem;
        }

        .qr-placeholder {
            width: 200px;
            height: 200px;
            margin: 1rem auto;
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            color: #1f2937;
            flex-direction: column;
        }

        .bank-details {
            background: rgba(30, 30, 50, 0.6);
            padding: 1rem;
            border-radius: 8px;
            margin-top: 1rem;
        }

        .bank-detail-row {
            display: flex;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(99, 102, 241, 0.2);
        }

            .bank-detail-row:last-child {
                border-bottom: none;
            }

        .bank-detail-label {
            color: #a0aec0;
            font-size: 0.9rem;
        }

        .bank-detail-value {
            color: #e4e6eb;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .copy-button {
            background: rgba(99, 102, 241, 0.2);
            border: 1px solid rgba(99, 102, 241, 0.3);
            padding: 0.3rem 0.8rem;
            border-radius: 5px;
            color: #a78bfa;
            font-size: 0.8rem;
            cursor: pointer;
            margin-left: 0.5rem;
            transition: all 0.2s ease;
        }

            .copy-button:hover {
                background: rgba(99, 102, 241, 0.3);
            }

        /* FAQ Section */
        .faq-section {
            padding: 4rem 5%;
            max-width: 700px;
            margin: 2rem auto;
        }

            .faq-section h2 {
                text-align: center;
                font-size: 2.2rem;
                margin-bottom: 3rem;
                font-weight: 700;
            }

        .faq-item {
            background: rgba(30, 30, 50, 0.6);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 10px;
            margin-bottom: 1.2rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .faq-item:hover {
                border-color: rgba(99, 102, 241, 0.4);
            }

        .faq-question {
            padding: 1.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 1rem;
            user-select: none;
            transition: all 0.3s ease;
        }

            .faq-question:hover {
                color: #6366f1;
            }

        .faq-toggle {
            font-size: 1.5rem;
            transition: transform 0.3s ease;
            color: #6366f1;
        }

        .faq-item.active .faq-toggle {
            transform: rotate(180deg);
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(99, 102, 241, 0.05);
        }

        .faq-item.active .faq-answer {
            max-height: 200px;
        }

        .faq-answer p {
            padding: 1.5rem;
            color: #cbd5e1;
            line-height: 1.6;
        }

        /* Footer */
        footer {
            padding: 2rem 5%;
            text-align: center;
            color: #a0aec0;
            border-top: 1px solid rgba(99, 102, 241, 0.2);
            margin-top: 4rem;
        }

            footer p {
                margin-bottom: 0.5rem;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            nav {
                padding: 1rem 4%;
                flex-wrap: wrap;
                gap: 1rem;
            }

                nav a {
                    margin-left: 1.5rem;
                    font-size: 0.85rem;
                }

            .hero {
                margin-top: 5rem;
                padding: 2rem 4%;
            }

                .hero h1 {
                    margin-bottom: 1rem;
                }

            .pricing-card {
                padding: 2rem;
                max-width: 100%;
            }

            .price {
                font-size: 2.5rem;
            }
        }

        .slide-layout {
            display: flex;
            align-items: flex-start;
            gap: 0;
        }

        /* Collapsed form */
        .subscription-form {
            width: 0;
            opacity: 0;
            overflow: hidden;
            transform: translateX(-20px);
            transition: width 0.5s ease, opacity 0.4s ease, transform 0.5s ease;
        }

            /* Expanded form */
            .subscription-form.active {
                width: 420px; /* match pricing-card width */
                opacity: 1;
                transform: translateX(0);
                padding-left: 40px;
            }

    </style>
</head>
<body>
    <!-- Navigation -->
    <nav>
        <div class="logo">Floatly Subscription</div>
        <div>
            <a href="#pricing">Pricing</a>
            <a href="#faq">FAQ</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-badge">✨ New Features Available</div>
        <h1>Unlock Premium Features</h1>
        <p>Get unlimited access to all features, priority support, and exclusive content. Join thousands of satisfied members today.</p>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="pricing-container slide-layout">
        <div class="pricing-card">
            <div class="pricing-header">
                <h3 class="plan-name">Floatly Plus</h3>
                <div>
                    <span class="price"><span class="currency">Rp.</span>5000</span>
                    <span class="billing-period">/month</span>
                </div>
                <p class="plan-description">Everything you need to enjoy the experience</p>
            </div>

            <ul class="features-list">
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">No Ads</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">HD Video Streaming</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Youtube Playlist Import</span>
                </li>
                <li class="feature-item">
                    <div class="feature-icon">✓</div>
                    <span class="feature-text">Playlist Download</span>
                </li>
            </ul>

            <button class="cta-button" onclick="handleSubscribe()">Buy Now</button>

        </div>

        <!-- Subscription Form -->
        <div class="subscription-form" id="subscriptionForm">
            <!-- User Verification Section -->
            <div class="form-section">
                <h4>🔐 Verify Your Account</h4>
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" class="form-input" placeholder="Enter your username" required>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" class="form-input" placeholder="Enter your password" required>
                </div>
                <button class="verify-button" onclick="verifyUser()" id="verifyBtn">
                    Verify Account
                </button>
                <div id="verificationStatus"></div>
            </div>

            <!-- Payment Section (Hidden until verified) -->
            <div class="payment-section" id="paymentSection">
                <button class="verify-button" onclick="startPayment()" id="verifyBtn">
                    Start Payment
                </button>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="faq-section">
        <h2>Frequently Asked Questions</h2>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>What payment methods do you accept?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>We accept all major credit cards (Visa, Mastercard, American Express), PayPal, and bank transfers for annual subscriptions. All payments are secure and encrypted.</p>
            </div>
        </div>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>Can I cancel anytime?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>Yes! You can cancel your subscription at any time. Your access will continue until the end of your current billing period, and we'll process any refunds according to our policy.</p>
            </div>
        </div>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>Is there a free trial?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>We offer a 14-day free trial with full access to all Premium Plan features. No credit card required to get started.</p>
            </div>
        </div>

        <div class="faq-item">
            <div class="faq-question" onclick="toggleFAQ(this)">
                <span>Do you offer team/enterprise plans?</span>
                <span class="faq-toggle">▼</span>
            </div>
            <div class="faq-answer">
                <p>Yes! For teams and enterprises, we offer custom plans with unlimited users, dedicated support, and advanced security features. Contact our sales team for more information.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contact">
        <p>&copy; 2025 Premium+. All rights reserved.</p>
        <p><a href="#" style="color: #6366f1; text-decoration: none;">Privacy Policy</a> | <a href="#" style="color: #6366f1; text-decoration: none;">Terms of Service</a></p>
    </footer>
    @{
        #if DEBUG
        <script src="https://app.sandbox.midtrans.com/snap/snap.js"
                data-client-key="@GlobalConfiguration.ClientKey"></script>
                #else
        <script src="https://app.midtrans.com/snap/snap.js"
                data-client-key="@GlobalConfiguration.ClientKey"></script>
                #endif
    }
    <script>
        async function startPayment() {
            const username = document.getElementById('username').value;

            const res = await fetch("/subs/pay?username=" + encodeURIComponent(username), {
                method: "POST"
            });

            if (!res.ok) {
                alert(await res.text());
                return;
            }

            const token = await res.text();
            snap.pay(token);
        }
    </script>

    <script>
                function showStatus(type, message) {
            const statusDiv = document.getElementById('verificationStatus');
            statusDiv.className = `verification-status ${type}`;

            if (type === 'loading') {
                statusDiv.innerHTML = `
                    <div class="spinner"></div>
                    <span>${message}</span>
                `;
            } else {
                statusDiv.innerHTML = `<span>${message}</span>`;
            }
        }
                let isFormExpanded = false;
                let isVerified = false;

                function toggleFAQ(element) {
                    const faqItem = element.parentElement;
                    faqItem.classList.toggle('active');
                }

                        async function verifyUser() {
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const verifyBtn = document.getElementById('verifyBtn');

            if (!username || !password) {
                showStatus('error', '❌ Please fill in all fields');
                return;
            }

            verifyBtn.disabled = true;
            showStatus('loading', '⏳ Verifying your credentials...');

            const form = new FormData();
            form.append("username", username);
            form.append("password", password);

            try {
                const res = await fetch("/auth/desktop/login", {
                    method: "POST",
                    body: form
                });

                if (!res.ok) {
                    showStatus('error', '❌ Invalid username or password');
                    verifyBtn.disabled = false;
                    return;
                }

                const user = await res.json();

                isVerified = true;
                showStatus('success', '✅ Verification successful! Proceeding to payment...');
                verifyBtn.textContent = '✓ Verified';
                verifyBtn.style.background = 'linear-gradient(135deg, #10b981, #059669)';

                document.getElementById('username').disabled = true;
                document.getElementById('password').disabled = true;

                // store token if you want
                localStorage.setItem("auth_token", user.token);

                document.getElementById('paymentSection').classList.add('active');
            } catch {
                showStatus('error', '❌ Server error. Please try again.');
                verifyBtn.disabled = false;
            }
        }
                function handleSubscribe() {
            const form = document.getElementById('subscriptionForm');
            const button = event.target;

            form.classList.toggle('active');

            button.textContent = form.classList.contains('active')
                ? 'Cancel'
                : 'Start Your Free Trial';
        }

    </script>
</body>

</html>