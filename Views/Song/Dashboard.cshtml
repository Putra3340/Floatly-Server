

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music Management Dashboard</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <style>
        :root {
            --bs-primary: #0d6efd;
            --bs-primary-rgb: 13, 110, 253;
        }

        body {
            background-color: #0a0e1a;
            color: #e9ecef;
        }

        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #1a1d29 0%, #0f1419 100%);
            border-right: 1px solid #2d3748;
        }

            .sidebar .nav-link {
                color: #a0aec0;
                padding: 0.75rem 1rem;
                margin: 0.25rem 0;
                border-radius: 0.5rem;
                transition: all 0.3s ease;
            }

                .sidebar .nav-link:hover {
                    background-color: rgba(13, 110, 253, 0.1);
                    color: #0d6efd;
                }

                .sidebar .nav-link.active {
                    background-color: #0d6efd;
                    color: white;
                }

        .main-content {
            background-color: #0f1419;
            min-height: 100vh;
        }

        .card {
            background-color: #1a1d29;
            border: 1px solid #2d3748;
        }

        .card-header {
            background-color: #2d3748;
            border-bottom: 1px solid #4a5568;
        }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

            .btn-primary:hover {
                background-color: #0b5ed7;
                border-color: #0a58ca;
            }

        .table-dark {
            --bs-table-bg: #1a1d29;
        }

        .navbar-brand {
            font-weight: 600;
            color: #0d6efd !important;
        }

        .content-section {
            display: none;
        }

            .content-section.active {
                display: block;
            }

        .stats-card {
            background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
            border: none;
            color: white;
        }

        .search-box {
            background-color: #2d3748;
            border: 1px solid #4a5568;
            color: #e9ecef;
        }

            .search-box:focus {
                background-color: #2d3748;
                border-color: #0d6efd;
                color: #e9ecef;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
                <div class="position-sticky pt-3">
                    <div class="text-center mb-4">
                        <h4 class="navbar-brand mb-0">
                            <i class="bi bi-music-note-beamed me-2"></i>
                            FloatLy
                        </h4>
                        <small class="text-muted">Management Dashboard</small>
                    </div>

                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="#" data-section="dashboard">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#albums" data-section="albums">
                                <i class="bi bi-disc me-2"></i>
                                Album Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#artists" data-section="artists">
                                <i class="bi bi-person-circle me-2"></i>
                                Artist Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#music" data-section="music">
                                <i class="bi bi-music-note-list me-2"></i>
                                Music Management
                            </a>
                        </li>
                    </ul>

                    <hr class="my-4">

                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-gear me-2"></i>
                                Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Logout">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <!-- Dashboard Section -->
                <div id="dashboard" class="content-section active">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Dashboard</h1>
                        <div class="btn-toolbar mb-2 mb-md-0">
                            @* <button type="button" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>
                                Add New
                            </button> *@
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-3 mb-3">
                            <div class="card stats-card">
                                <div class="card-body text-center">
                                    <i class="bi bi-disc fs-1 mb-2"></i>
                                    <h3 class="card-title">@ViewBag.TotalAlbums</h3>
                                    <p class="card-text">Total Albums</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card stats-card">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-circle fs-1 mb-2"></i>
                                    <h3 class="card-title">@ViewBag.TotalArtists</h3>
                                    <p class="card-text">Artists</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card stats-card">
                                <div class="card-body text-center">
                                    <i class="bi bi-music-note-list fs-1 mb-2"></i>
                                    <h3 class="card-title">@ViewBag.TotalSongs</h3>
                                    <p class="card-text">Songs</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card stats-card">
                                <div class="card-body text-center">
                                    <i class="bi bi-play-circle fs-1 mb-2"></i>
                                    <h3 class="card-title">45.2K</h3>
                                    <p class="card-text">Total Plays</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Recent Activity</h5>
                                </div>
                                <div class="card-body">
                                    <div class="list-group list-group-flush">
                                        <div class="list-group-item bg-transparent border-0">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1">New album "Midnight Dreams" added</h6>
                                                <small>2 hours ago</small>
                                            </div>
                                            <p class="mb-1">Artist: Sarah Johnson</p>
                                        </div>
                                        <div class="list-group-item bg-transparent border-0">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1">Artist profile updated</h6>
                                                <small>5 hours ago</small>
                                            </div>
                                            <p class="mb-1">Mike Rodriguez updated his bio</p>
                                        </div>
                                        <div class="list-group-item bg-transparent border-0">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1">New song uploaded</h6>
                                                <small>1 day ago</small>
                                            </div>
                                            <p class="mb-1">"Electric Nights" by The Neon Band</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">Top Artists</h5>
                                </div>
                                <div class="card-body">
                                    <div class="list-group list-group-flush">
                                        <div class="list-group-item bg-transparent border-0 d-flex justify-content-between">
                                            <span>Sarah Johnson</span>
                                            <span class="badge bg-primary">12 albums</span>
                                        </div>
                                        <div class="list-group-item bg-transparent border-0 d-flex justify-content-between">
                                            <span>The Neon Band</span>
                                            <span class="badge bg-primary">8 albums</span>
                                        </div>
                                        <div class="list-group-item bg-transparent border-0 d-flex justify-content-between">
                                            <span>Mike Rodriguez</span>
                                            <span class="badge bg-primary">6 albums</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Albums Section -->
                <div id="albums" class="content-section">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Album Management</h1>
                        <div class="btn-toolbar mb-2 mb-md-0">
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#albumModal" onclick="openAlbumModal()">
                                <i class="bi bi-plus-circle me-1"></i>
                                Add Album
                            </button>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control search-box" placeholder="Search albums...">
                        </div>
                        <div class="col-md-6">
                            <select class="form-select search-box">
                                <option>All Genres</option>
                                <option>Rock</option>
                                <option>Pop</option>
                                <option>Jazz</option>
                                <option>Electronic</option>
                            </select>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-dark table-hover">
                                    <thead>
                                        <tr>
                                            <th>Album</th>
                                            <th>Artist</th>
                                            <th>Release Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var album in ViewBag.Albums)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-primary rounded me-3" style="width: 40px; height: 40px;"></div>
                                                        <div>
                                                            <strong>@album.Title</strong>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@album.Artist.Name</td>
                                                <td>@album.ReleaseDate?.ToString("dd MMMM yyyy")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#albumModal" onclick="openAlbumModal(@album.Id, '@album.Title', @album.ArtistId)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <form action="/Album/Delete" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@album.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm"
                                                                onclick="return confirm('Delete @album.Title?')">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>

                                                </td>
                                            </tr>
                                        }
                                        
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Artists Section -->
                <div id="artists" class="content-section">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Artist Management</h1>
                        <div class="btn-toolbar mb-2 mb-md-0">
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#artistModal"
                                    onclick="openModal()">
                                <i class="bi bi-plus-circle me-1"></i>
                                Add Artist
                            </button>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <input type="text" class="form-control search-box" placeholder="Search artists...">
                        </div>
                        <div class="col-md-4">
                            <select class="form-select search-box">
                                <option>All Status</option>
                                <option>Active</option>
                                <option>Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        @foreach (var artist in ViewBag.Artists)  // assuming Model is IEnumerable<Artists>
                        {
                            <div class="col-md-4 mb-4">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <div class="bg-primary rounded-circle mx-auto mb-3"
                                             style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                                            @if (!string.IsNullOrEmpty(artist.ProfileUrl))
                                            {
                                                <img src="@artist.ProfileUrl" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person fs-1 text-white"></i>
                                            }
                                        </div>
                                        <h5 class="card-title">@artist.Name</h5>
                                    <p class="card-text text-muted">
                                        @(artist.Bio?.Length > 50
                                                                                ? artist.Bio.Substring(0, 100) + "..."
                                                                                : artist.Bio)
                                    </p>
                                        <div class="d-flex justify-content-center mb-3">
                                            <small class="me-3"><strong>@artist.Albums.Count</strong> Albums</small>
                                            @* <small><strong>@artist.Albums.Sum(a => a.Songs.Count)</strong> Songs</small> *@
                                        </div>
                                        <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#artistModal"
                                           onclick="openModal(@artist.Id, '@artist.Name', '@artist.Bio')">Edit</a>
                                            <a asp-action="Details" asp-controller="Artists" asp-route-id="@artist.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                        <form action="/Artist/Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@artist.Id" />

                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Delete @artist.Name?')">
                                                Delete
                                            </button>
                                        </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Music Section -->
                <div id="music" class="content-section">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Music Management</h1>
                        <div class="btn-toolbar mb-2 mb-md-0">
                            <button type="button" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>
                                Add Song
                            </button>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <input type="text" class="form-control search-box" placeholder="Search songs...">
                        </div>
                        <div class="col-md-4">
                            <select class="form-select search-box">
                                <option>All Artists</option>
                                <option>Sarah Johnson</option>
                                <option>The Neon Band</option>
                                <option>Mike Rodriguez</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select search-box">
                                <option>All Albums</option>
                                <option>Midnight Dreams</option>
                                <option>Electric Vibes</option>
                                <option>Acoustic Sessions</option>
                            </select>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-dark table-hover">
                                    <thead>
                                        <tr>
                                            <th>Song</th>
                                            <th>Artist</th>
                                            <th>Album</th>
                                            <th>Duration</th>
                                            <th>Plays</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var music in ViewBag.Songs)
                                        {
                                            <tr>
                                                <td>
                                                <div class="d-flex align-items-center">
                                                    <button class="btn btn-sm btn-outline-primary me-3">
                                                        <i class="bi bi-play-fill"></i>
                                                    </button>
                                                    <div>
                                                        <strong>@music.Title</strong>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@music.Album.Artist.Name</td>
                                            <td>@music.Album.Title</td>
                                            <td>3:42</td>
                                            <td>2,847</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary me-1">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Album Modal -->
                <div class="modal fade" id="albumModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form id="albumForm" method="post">
                                <div class="modal-header">
                                    <h5 class="modal-title">Album</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="Id" id="albumId" />

                                    <div class="mb-3">
                                        <label for="albumTitle" class="form-label">Title</label>
                                        <input type="text" name="Title" id="albumTitle" class="form-control" required />
                                    </div>

                                    <div class="mb-3">
                                        <label for="albumArtistId" class="form-label">Artist</label>
                                        <select name="ArtistId" id="albumArtistId" class="form-select">
                                            <option value="">-- Select Artist --</option>
                                            @foreach (var artist in ViewBag.Artists)
                                            {
                                                <option value="@artist.Id">@artist.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label for="albumReleaseDate" class="form-label">Release Date</label>
                                        <input type="date" name="ReleaseDate" id="albumReleaseDate" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label for="albumCoverUrl" class="form-label">Cover URL</label>
                                        <input type="text" name="CoverUrl" id="albumCoverUrl" class="form-control" />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-success">Save</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- Artists Modal -->
                <div class="modal fade" id="artistModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form id="artistForm" method="post">
                                <div class="modal-header">
                                    <h5 class="modal-title">Artist</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="Id" id="artistId" />
                                    <div class="mb-3">
                                        <label for="artistName" class="form-label">Name</label>
                                        <input type="text" name="Name" id="artistName" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label for="artistBio" class="form-label">Bio</label>
                                        <textarea name="Bio" id="artistBio" class="form-control"></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-success">Save</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        function openAlbumModal(id = 0, title = '', artistId = '', releaseDate = '', coverUrl = '') {
            document.getElementById('albumId').value = id;
            document.getElementById('albumTitle').value = title;
            document.getElementById('albumArtistId').value = artistId;
            document.getElementById('albumReleaseDate').value = releaseDate;
            document.getElementById('albumCoverUrl').value = coverUrl;

            document.getElementById('albumForm').action = id == 0 ? '/Album/Create' : '/Album/Edit';
        }
        function openModal(id = 0, name = '', bio = '') {
            document.getElementById('artistId').value = id;
            document.getElementById('artistName').value = name;
            document.getElementById('artistBio').value = bio;
            document.getElementById('artistForm').action = id == 0 ? '/Artist/Create' : '/Artist/Edit';
        }
    </script>
    <script>
                function openSectionFromHash() {
            const hash = window.location.hash.substring(1); //remove '#'
            if (!hash) return;

            const section = document.getElementById(hash);
            if (section) {
                // hide all
                document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
                // show target
                section.classList.add('active');

                // update nav
                document.querySelectorAll('.sidebar .nav-link').forEach(link => link.classList.remove('active'));
                const nav = document.querySelector(`.sidebar .nav-link[data-section="${hash}"]`);
                if (nav) nav.classList.add('active');
            }
        }
                document.addEventListener('DOMContentLoaded', function () {
            openSectionFromHash();

            // also re-run when hash changes (user clicks back/forward)
            window.addEventListener('hashchange', openSectionFromHash);
        });
        // Navigation functionality
        document.addEventListener('DOMContentLoaded', function() {
            const navLinks = document.querySelectorAll('.sidebar .nav-link[data-section]');
            const contentSections = document.querySelectorAll('.content-section');

            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Remove active class from all nav links
                    navLinks.forEach(nl => nl.classList.remove('active'));

                    // Add active class to clicked link
                    this.classList.add('active');

                    // Hide all content sections
                    contentSections.forEach(section => section.classList.remove('active'));

                    // Show target section
                    const targetSection = this.getAttribute('data-section');
                    document.getElementById(targetSection).classList.add('active');
                });
            });

            // Search functionality (basic implementation)
            const searchInputs = document.querySelectorAll('.search-box[type="text"]');
            searchInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const table = this.closest('.content-section').querySelector('table tbody');

                    if (table) {
                        const rows = table.querySelectorAll('tr');
                        rows.forEach(row => {
                            const text = row.textContent.toLowerCase();
                            row.style.display = text.includes(searchTerm) ? '' : 'none';
                        });
                    }
                });
            });

            // Play button functionality
            document.addEventListener('click', function(e) {
                if (e.target.closest('.btn') && e.target.closest('.btn').querySelector('.bi-play-fill')) {
                    const playBtn = e.target.closest('.btn');
                    const icon = playBtn.querySelector('i');

                    if (icon.classList.contains('bi-play-fill')) {
                        icon.classList.remove('bi-play-fill');
                        icon.classList.add('bi-pause-fill');
                        playBtn.classList.remove('btn-outline-primary');
                        playBtn.classList.add('btn-primary');
                    } else {
                        icon.classList.remove('bi-pause-fill');
                        icon.classList.add('bi-play-fill');
                        playBtn.classList.remove('btn-primary');
                        playBtn.classList.add('btn-outline-primary');
                    }
                }
            });
        });
    </script>
</body>
</html>