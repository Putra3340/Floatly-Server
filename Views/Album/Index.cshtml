@model IEnumerable<Floaty_Music.Models.Albums>
@{
    var artists = ViewBag.Artists as List<Floaty_Music.Models.Artists>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Albums</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <h2>Albums</h2>
        <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#albumModal"
                onclick="openAlbumModal()">
            + Add Album
        </button>

        <table class="table table-bordered">
            <thead>
                <tr><th>Title</th><th>Artist</th><th>Release Date</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var album in Model)
                {
                    <tr>
                        <td>@album.Title</td>
                        <td>@album.Artist.Name</td>
                        <td>@album.ReleaseDate?.ToString("dd MMMM yyyy")</td>
                        <td>
                            <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#albumModal"
                                    onclick="openAlbumModal(@album.Id, '@album.Title', @album.ArtistId)">
                                Edit
                            </button>
                            <form asp-action="Delete" asp-route-id="@album.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete @album.Title?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Album Modal -->
    <div class="modal fade" id="albumModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="albumForm" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Album</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Id" id="albumId" />

                        <div class="mb-3">
                            <label for="albumTitle" class="form-label">Title</label>
                            <input type="text" name="Title" id="albumTitle" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="albumArtistId" class="form-label">Artist</label>
                            <select name="ArtistId" id="albumArtistId" class="form-select">
                                <option value="">-- Select Artist --</option>
                                @foreach (var artist in artists)
                                {
                                    <option value="@artist.Id">@artist.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="albumReleaseDate" class="form-label">Release Date</label>
                            <input type="date" name="ReleaseDate" id="albumReleaseDate" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label for="albumCoverUrl" class="form-label">Cover URL</label>
                            <input type="text" name="CoverUrl" id="albumCoverUrl" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openAlbumModal(id = 0, title = '', artistId = '', releaseDate = '', coverUrl = '') {
            document.getElementById('albumId').value = id;
            document.getElementById('albumTitle').value = title;
            document.getElementById('albumArtistId').value = artistId;
            document.getElementById('albumReleaseDate').value = releaseDate;
            document.getElementById('albumCoverUrl').value = coverUrl;

            document.getElementById('albumForm').action = id == 0 ? '/Album/Create' : '/Album/Edit';
        }
    </script>
</body>
</html>
